{
  "info": {
    "name": "ERP Backend API Collection",
    "description": "Auto-generated Postman Collection with separate Admin Auth (RBAC) and User Auth endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:3000/health",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "health"
          ]
        }
      }
    },
    {
      "name": "Admin Portal",
      "item": [
        {
          "name": "Admin Auth",
          "item": [
            {
              "name": "Admin Login",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"Admin@123456\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/admin/auth/login",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "admin",
                    "auth",
                    "login"
                  ]
                }
              }
            },
            {
              "name": "Admin Me",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{adminToken}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/admin/auth/me",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "admin",
                    "auth",
                    "me"
                  ]
                }
              }
            }
          ]
        },
        {
          "name": "Admin Management",
          "item": [
            {
              "name": "List Admins",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{adminToken}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/admin/admins",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "admin",
                    "admins"
                  ]
                }
              }
            }
          ]
        },
        {
          "name": "User Management (Admin)",
          "item": [
            {
              "name": "List Standard Users",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{adminToken}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/admin/users",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "admin",
                    "users"
                  ]
                }
              }
            }
          ]
        }
      ]
    },
    {
      "name": "User Portal",
      "item": [
        {
          "name": "User Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"Password@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/user/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user",
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "User Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"User@123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/user/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "User Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/user/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user",
                "auth",
                "me"
              ]
            }
          }
        }
      ]
    }
  ]
}