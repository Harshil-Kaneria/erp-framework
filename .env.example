# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL or MySQL)
# Set DB_DIALECT to 'postgres' or 'mysql'
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=erp_db
DB_USER=postgres
DB_PASS=postgres
DB_DIALECT=postgres
DB_LOGGING=false

# Authentication Configuration
JWT_SECRET=super-secret-erp-jwt-access-key-2026-change-in-prod
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super-secret-erp-jwt-refresh-key-2026-change-in-prod
JWT_REFRESH_EXPIRES_IN=7d

# File Storage Configuration
# Storage Driver Options: 'local' or 's3'
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# AWS S3 Configuration (used when STORAGE_DRIVER=s3 or via s3UploadHelper)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=erp-app-file-uploads
